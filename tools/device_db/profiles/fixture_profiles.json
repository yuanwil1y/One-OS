{
  "_comment": [
    "Canonical Device DB profile input for the B4 fixture corpus.",
    "",
    "This is deliberately a SMALL, hand-authored corpus. It is the reference input",
    "that proves the format, the generator, the validator and the firmware reader",
    "agree; it is NOT the production recognition database, which lives on SD.",
    "",
    "The shape rule for every profile here: only exact protocol facts become",
    "entities. If a value was never observed or never published by the protocol,",
    "no entity recipe is written for it. Nothing in this file invents a sensor,",
    "a capability or a device identity.",
    "",
    "Each profile is designed to exercise one behaviour:",
    "  1001  a recognised BLE broadcast sensor (known device)",
    "  1002  a recognised Zigbee switch (known device, writable)",
    "  1003  a second profile sharing 1001's manufacturer id, so a payload with",
    "        only that id is AMBIGUOUS and must stay non-writable",
    "  1004  a similar-looking but distinct BLE model that must NOT merge with 1001",
    "  1005  a LAN service profile matched by mDNS service type",
    "  none  unknown devices are not represented at all: no profile exists for",
    "        them, which is exactly how 'unknown' is produced"
  ],
  "profiles": [
    {
      "profile_id": 1001,
      "vendor": "Example",
      "model": "TH-BEACON-1",
      "display_name": "Example Temp/Humidity Beacon",
      "icon": "thermometer",
      "provenance": {
        "source_id": 1,
        "reuse": "copy",
        "license": "public_domain",
        "source_revision": "20260911",
        "source_name": "one-os-owned-fixtures",
        "review": "Authored for One-OS from the published BTHome v2 layout."
      },
      "policy": ["passive_only"],
      "writable": false,
      "theengs_decoder_id": 1,
      "fingerprints": [
        {
          "protocol": "ble",
          "key": "181c",
          "_note": "BTHome v2 service UUID in little-endian wire order."
        }
      ],
      "identity_rules": [
        {
          "kind": "vendor_protocol_uuid",
          "strength": "weak",
          "key": "181c"
        }
      ],
      "recipes": [
        {
          "domain": "sensor",
          "name": "Temperature",
          "device_class": "temperature",
          "unit": "C",
          "backend": "passive_value",
          "read_source_id": 1,
          "min_value": -4000,
          "max_value": 8500,
          "scale": 2
        },
        {
          "domain": "sensor",
          "name": "Humidity",
