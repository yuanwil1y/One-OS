# One-OS foundation defaults for Waveshare ESP32-C6-Touch-LCD-1.9.
# Select target with: idf.py set-target esp32c6

CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_8mb.csv"

# Native wireless capabilities reserved for applications and independent APIs.
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_50_FEATURE_SUPPORT=y
CONFIG_BT_NIMBLE_EXT_ADV=y
CONFIG_IEEE802154_ENABLED=y

# OpenThread network-layer support for the independent openthread_* L2 family.
# Matter controller does not initialize a second local Thread device stack.
CONFIG_OPENTHREAD_ENABLED=y
CONFIG_OPENTHREAD_FTD=y
CONFIG_OPENTHREAD_RADIO_NATIVE=y
CONFIG_OPENTHREAD_PLATFORM_NETIF=y
CONFIG_OPENTHREAD_JOINER=y
CONFIG_OPENTHREAD_BORDER_ROUTER=n
CONFIG_OPENTHREAD_COMMISSIONER=n
CONFIG_OPENTHREAD_CONSOLE_ENABLE=n
CONFIG_OPENTHREAD_CLI=n
CONFIG_OPENTHREAD_SRP_CLIENT=n
CONFIG_OPENTHREAD_DNS_CLIENT=n
CONFIG_OPENTHREAD_DIAG=n

# OpenThread MeshCoP Joiner uses DTLS with the EC-JPAKE cipher suite. ESP-IDF v6.1
# ships mbedTLS 4 with these features disabled by default.
CONFIG_MBEDTLS_SSL_PROTO_DTLS=y
CONFIG_MBEDTLS_KEY_EXCHANGE_ECJPAKE=y
CONFIG_MBEDTLS_ECJPAKE_C=y

# Direct connectedhomeip controller-only integration.
CONFIG_ENABLE_CHIP_CONTROLLER_BUILD=y
CONFIG_ENABLE_CHIP_SHELL=n
CONFIG_BUILD_CHIP_TESTS=n
CONFIG_ENABLE_OTA_REQUESTOR=n
CONFIG_ENABLE_PERSIST_SUBSCRIPTIONS=n
CONFIG_CHIP_DEVICE_ENABLE_DYNAMIC_SERVER=n
CONFIG_ENABLE_WIFI_STATION=y
CONFIG_ENABLE_CHIPOBLE=y
CONFIG_ENABLE_ESP32_BLE_CONTROLLER=y
CONFIG_ENABLE_MATTER_OVER_THREAD=n
CONFIG_WIFI_NETWORK_COMMISSIONING_DRIVER=n
CONFIG_THREAD_NETWORK_COMMISSIONING_DRIVER=n
CONFIG_MBEDTLS_HKDF_C=y
CONFIG_CHIP_TASK_STACK_SIZE=15360
CONFIG_ESP_MAIN_TASK_STACK_SIZE=10240
CONFIG_NUM_UDP_ENDPOINTS=16
CONFIG_LWIP_HOOK_IP6_ROUTE_DEFAULT=y
CONFIG_LWIP_HOOK_ND6_GET_GW_DEFAULT=y
CONFIG_LWIP_IPV6_AUTOCONFIG=y
CONFIG_LWIP_IPV6_NUM_ADDRESSES=6
CONFIG_CHIP_PROJECT_CONFIG="main/matter_project_config.h"

# LVGL v8.3 baseline. ESP32-C6 board has no PSRAM in this project baseline.
CONFIG_LV_CONF_MINIMAL=y
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_MEM_SIZE_KILOBYTES=32
CONFIG_LV_DRAW_COMPLEX=y
CONFIG_LV_USE_USER_DATA=y
CONFIG_LV_USE_FLEX=y
CONFIG_LV_USE_GRID=n
CONFIG_LV_USE_BAR=y
CONFIG_LV_USE_BTN=y
CONFIG_LV_USE_LABEL=y
CONFIG_LV_USE_SWITCH=y
CONFIG_LV_USE_THEME_DEFAULT=y
CONFIG_LV_FONT_DEFAULT_MONTSERRAT_14=y
CONFIG_LV_BUILD_EXAMPLES=n
CONFIG_LV_USE_DEMO_WIDGETS=n
CONFIG_LV_USE_DEMO_KEYPAD_AND_ENCODER=n
CONFIG_LV_USE_DEMO_BENCHMARK=n
CONFIG_LV_USE_DEMO_STRESS=n
CONFIG_LV_USE_DEMO_MUSIC=n
CONFIG_LV_USE_GPU_ARM2D=n
CONFIG_LV_USE_GPU_STM32_DMA2D=n
CONFIG_LV_USE_GPU_RA6M3_G2D=n
CONFIG_LV_USE_GPU_SWM341_DMA2D=n
CONFIG_LV_USE_GPU_NXP_PXP=n
CONFIG_LV_USE_GPU_NXP_VG_LITE=n
CONFIG_LV_USE_GPU_SDL=n
CONFIG_LV_USE_PNG=n
CONFIG_LV_USE_BMP=n
CONFIG_LV_USE_SJPG=n
CONFIG_LV_USE_GIF=n
CONFIG_LV_USE_QRCODE=n
CONFIG_LV_USE_FREETYPE=n
CONFIG_LV_USE_RLOTTIE=n
CONFIG_LV_USE_FFMPEG=n
